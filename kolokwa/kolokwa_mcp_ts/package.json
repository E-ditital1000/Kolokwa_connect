{
  "name": "kolokwa-dictionary-mcp",
  "version": "2.0.0",
  "description": "Enhanced MCP server for the Liberian Kolokwa Dictionary platform with AI-powered translation",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "kolokwa-dictionary-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "prepare": "npm run build",
    "clean": "rm -rf build",
    "rebuild": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "dictionary",
    "kolokwa",
    "liberia",
    "translation",
    "ai",
    "natural-language",
    "language-learning"
  ],
  "author": "Kolokwa Connect",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pg": "^8.13.1",
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/E-ditital1000/Kolokwa_connect.git"
  }
}